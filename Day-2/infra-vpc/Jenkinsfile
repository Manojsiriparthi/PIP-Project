root@ip-10-0-1-101:~# 
root@ip-10-0-1-101:~# 
root@ip-10-0-1-101:~# 
root@ip-10-0-1-101:~# cat jenkins 
pipeline {

    agent any

    options {
        timestamps()
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '20',
                artifactNumToKeepStr: '10'
            )
        )
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'prod'
            ],
            description: 'Select Terraform environment'
        )

        choice(
            name: 'ACTION',
            choices: [
                'apply',
                'destroy'
            ],
            description: 'Select Terraform action'
        )
    }

    environment {
        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'

        /*
         * Repository structure:
         *
         * Day-2/
         * └── infra-vpc/
         *     └── envs/
         *         ├── dev/
         *         └── prod/
         */
        TERRAFORM_BASE_DIR = 'Day-2/infra-vpc/envs'
    }

    stages {

        /*
         * ==========================================
         * 1. CHECKOUT
         * ==========================================
         */

        stage('Checkout') {

            steps {

                echo "Checking out Git repository..."

                checkout scm

                echo "Checkout completed."
            }
        }


        /*
         * ==========================================
         * 2. BUILD INFORMATION
         * ==========================================
         */

        stage('Build Information') {

            steps {

                echo """
================================================
Terraform CI/CD Pipeline
================================================

Environment : ${params.ENVIRONMENT}
Action      : ${params.ACTION}

Terraform Directory:
${TERRAFORM_BASE_DIR}/${params.ENVIRONMENT}

================================================
"""
            }
        }


        /*
         * ==========================================
         * 3. TERRAFORM FORMAT CHECK
         * ==========================================
         */

        stage('Terraform Format Check') {

            steps {

                dir("${TERRAFORM_BASE_DIR}/${params.ENVIRONMENT}") {

                    sh '''
                        echo "========================================"
                        echo "Terraform Format Check"
                        echo "========================================"

                        terraform fmt -check

                        echo "Terraform format check PASSED."
                    '''
                }
            }
        }


        /*
         * ==========================================
         * 4. TERRAFORM INIT
         * ==========================================
         */

        stage('Terraform Init') {

            steps {

                dir("${TERRAFORM_BASE_DIR}/${params.ENVIRONMENT}") {

                    sh '''
                        echo "========================================"
                        echo "Terraform Init"
                        echo "========================================"

                        terraform init -input=false

                        echo "Terraform init PASSED."
                    '''
                }
            }
        }


        /*
         * ==========================================
         * 5. TERRAFORM VALIDATE
         * ==========================================
         */

        stage('Terraform Validate') {

            steps {

                dir("${TERRAFORM_BASE_DIR}/${params.ENVIRONMENT}") {

                    sh '''
                        echo "========================================"
                        echo "Terraform Validate"
                        echo "========================================"

                        terraform validate

                        echo "Terraform validate PASSED."
                    '''
                }
            }
        }


        /*
         * ==========================================
         * 6. TERRAFORM PLAN
         * ==========================================
         */

        stage('Terraform Plan') {

            steps {

                dir("${TERRAFORM_BASE_DIR}/${params.ENVIRONMENT}") {

                    script {

                        echo """
================================================
Terraform Plan
================================================
Environment : ${params.ENVIRONMENT}
Action      : ${params.ACTION}
================================================
"""

                        if (params.ACTION == 'apply') {

                            echo "Creating Terraform APPLY plan..."

                            sh '''
                                terraform plan \
                                    -input=false \
                                    -out=tfplan

                                terraform show \
                                    -no-color \
                                    tfplan > tfplan.txt
                            '''

                        }

                        else if (params.ACTION == 'destroy') {

                            echo "Creating Terraform DESTROY plan..."

                            sh '''
                                terraform plan \
                                    -destroy \
                                    -input=false \
                                    -out=tfplan

                                terraform show \
                                    -no-color \
                                    tfplan > tfplan.txt
                            '''
                        }


                        /*
                         * Verify that Terraform generated
                         * both plan files.
                         */

                        echo "Checking Terraform plan files..."

                        sh '''
                            echo "Files generated:"
                            ls -lh tfplan
                            ls -lh tfplan.txt
                        '''


                        /*
                         * Archive the human-readable plan.
                         *
                         * IMPORTANT:
                         * We are already inside:
                         *
                         * Day-2/infra-vpc/envs/dev
                         *
                         * OR
                         *
                         * Day-2/infra-vpc/envs/prod
                         *
                         * Therefore only tfplan.txt is required.
                         */

                        archiveArtifacts(
                            artifacts: 'tfplan.txt',
                            fingerprint: true
                        )

                        echo "Terraform plan archived successfully."
                    }
                }
            }
        }


        /*
         * ==========================================
         * 7. MANUAL APPROVAL
         * ==========================================
         */

        stage('Manual Approval') {

            steps {

                script {

                    def approvalMessage = """
================================================

TERRAFORM MANUAL APPROVAL REQUIRED

Environment : ${params.ENVIRONMENT}
Action      : ${params.ACTION}

The Terraform plan has completed successfully.

Please review the archived tfplan.txt
before approving this operation.

================================================
"""

                    timeout(
                        time: 30,
                        unit: 'MINUTES'
                    ) {

                        input(
                            message: approvalMessage,
                            ok: "APPROVE ${params.ACTION.toUpperCase()}"
                        )
                    }
                }
            }
        }


        /*
         * ==========================================
         * 8. TERRAFORM APPLY
         * ==========================================
         */

        stage('Terraform Apply') {

            when {

                expression {
                    params.ACTION == 'apply'
                }
            }

            steps {

                dir("${TERRAFORM_BASE_DIR}/${params.ENVIRONMENT}") {

                    sh '''
                        echo "========================================"
                        echo "Terraform Apply"
                        echo "========================================"

                        terraform apply \
                            -input=false \
                            -auto-approve \
                            tfplan

                        echo "Terraform APPLY completed successfully."
                    '''
                }
            }
        }


        /*
         * ==========================================
         * 9. TERRAFORM DESTROY
         * ==========================================
         */

        stage('Terraform Destroy') {

            when {

                expression {
                    params.ACTION == 'destroy'
                }
            }

            steps {

                dir("${TERRAFORM_BASE_DIR}/${params.ENVIRONMENT}") {

                    sh '''
                        echo "========================================"
                        echo "Terraform Destroy"
                        echo "========================================"

                        terraform apply \
                            -input=false \
                            -auto-approve \
                            tfplan

                        echo "Terraform DESTROY completed successfully."
                    '''
                }
            }
        }
    }


    /*
     * ==========================================
     * POST ACTIONS
     * ==========================================
     */

    post {

        success {

            echo """
================================================
PIPELINE SUCCESS
================================================

Environment : ${params.ENVIRONMENT}
Action      : ${params.ACTION}
Build       : ${BUILD_NUMBER}

Terraform operation completed successfully.

================================================
"""
        }


        failure {

            echo """
================================================
PIPELINE FAILED
================================================

Environment : ${params.ENVIRONMENT}
Action      : ${params.ACTION}
Build       : ${BUILD_NUMBER}

Please check the console output for the failure.

================================================
"""
        }


        aborted {

            echo """
================================================
PIPELINE ABORTED
================================================

Environment : ${params.ENVIRONMENT}
Action      : ${params.ACTION}

================================================
"""
        }


        always {

            echo "Pipeline execution finished."
        }
    }
}
