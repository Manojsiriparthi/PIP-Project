pipeline {

    agent any

    options {
        timestamps()
        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '20',
                artifactNumToKeepStr: '10'
            )
        )
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: [
                'dev',
                'prod'
            ],
            description: 'Select Terraform environment'
        )

        choice(
            name: 'ACTION',
            choices: [
                'apply',
                'destroy'
            ],
            description: 'Select Terraform action'
        )
    }

    environment {
        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'

        INFRA_DIR = 'Day-2/infra-vpc/envs'
    }

    stages {

        /*
         * ==========================================
         * 1. CHECKOUT
         * ==========================================
         */

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        /*
         * ==========================================
         * 2. SHOW BUILD INFORMATION
         * ==========================================
         */

        stage('Build Information') {
            steps {
                echo """
========================================
Terraform CI/CD Pipeline
========================================

Environment : ${params.ENVIRONMENT}
Action      : ${params.ACTION}

Terraform directory:
${INFRA_DIR}/${params.ENVIRONMENT}

========================================
"""
            }
        }

        /*
         * ==========================================
         * 3. TERRAFORM FORMAT
         * ==========================================
         */

        stage('Terraform Format') {
            steps {
                sh '''
                    echo "Checking Terraform formatting..."

                    terraform fmt -check -recursive Day-2/infra-vpc

                    echo "Terraform format check completed."
                '''
            }
        }

        /*
         * ==========================================
         * 4. TERRAFORM INIT
         * ==========================================
         */

        stage('Terraform Init') {
            steps {

                dir("${INFRA_DIR}/${params.ENVIRONMENT}") {

                    sh '''
                        echo "Initializing Terraform..."

                        terraform init -input=false

                        echo "Terraform init completed."
                    '''
                }
            }
        }

        /*
         * ==========================================
         * 5. TERRAFORM VALIDATE
         * ==========================================
         */

        stage('Terraform Validate') {
            steps {

                dir("${INFRA_DIR}/${params.ENVIRONMENT}") {

                    sh '''
                        echo "Validating Terraform..."

                        terraform validate

                        echo "Terraform validation completed."
                    '''
                }
            }
        }

        /*
         * ==========================================
         * 6. TERRAFORM PLAN
         * ==========================================
         */

        stage('Terraform Plan') {
            steps {

                dir("${INFRA_DIR}/${params.ENVIRONMENT}") {

                    script {

                        if (params.ACTION == 'apply') {

                            echo """
========================================
TERRAFORM PLAN
Environment : ${params.ENVIRONMENT}
Action      : APPLY
========================================
"""

                            sh '''
                                terraform plan \
                                    -input=false \
                                    -out=tfplan

                                terraform show \
                                    -no-color \
                                    tfplan > tfplan.txt
                            '''

                        } else {

                            echo """
========================================
TERRAFORM DESTROY PLAN
Environment : ${params.ENVIRONMENT}
Action      : DESTROY
========================================
"""

                            sh '''
                                terraform plan \
                                    -destroy \
                                    -input=false \
                                    -out=tfplan

                                terraform show \
                                    -no-color \
                                    tfplan > tfplan.txt
                            '''
                        }

                        archiveArtifacts(
                            artifacts: 'tfplan.txt',
                            fingerprint: true
                        )
                    }
                }
            }
        }

        /*
         * ==========================================
         * 7. MANUAL APPROVAL
         * ==========================================
         */

        stage('Manual Approval') {
            steps {

                script {

                    timeout(
                        time: 30,
                        unit: 'MINUTES'
                    ) {

                        input(
                            message: """
========================================

TERRAFORM APPROVAL REQUIRED

Environment : ${params.ENVIRONMENT}
Action      : ${params.ACTION}

Review the Terraform plan artifact
before approving.

========================================
""",
                            ok: "APPROVE ${params.ACTION.toUpperCase()}"
                        )
                    }
                }
            }
        }

        /*
         * ==========================================
         * 8. APPLY
         * ==========================================
         */

        stage('Terraform Apply') {

            when {
                expression {
                    params.ACTION == 'apply'
                }
            }

            steps {

                dir("${INFRA_DIR}/${params.ENVIRONMENT}") {

                    sh '''
                        echo "Applying Terraform plan..."

                        terraform apply \
                            -input=false \
                            -auto-approve \
                            tfplan

                        echo "Terraform apply completed."
                    '''
                }
            }
        }

        /*
         * ==========================================
         * 9. DESTROY
         * ==========================================
         */

        stage('Terraform Destroy') {

            when {
                expression {
                    params.ACTION == 'destroy'
                }
            }

            steps {

                dir("${INFRA_DIR}/${params.ENVIRONMENT}") {

                    sh '''
                        echo "Destroying infrastructure..."

                        terraform apply \
                            -input=false \
                            -auto-approve \
                            tfplan

                        echo "Terraform destroy completed."
                    '''
                }
            }
        }
    }

    /*
     * ==========================================
     * POST ACTIONS
     * ==========================================
     */

    post {

        success {
            echo """
========================================
PIPELINE SUCCESS
========================================

Environment : ${params.ENVIRONMENT}
Action      : ${params.ACTION}
Build       : ${BUILD_NUMBER}

========================================
"""
        }

        failure {
            echo """
========================================
PIPELINE FAILED
========================================

Environment : ${params.ENVIRONMENT}
Action      : ${params.ACTION}
Build       : ${BUILD_NUMBER}

========================================
"""
        }

        aborted {
            echo """
========================================
PIPELINE ABORTED
========================================

Environment : ${params.ENVIRONMENT}
Action      : ${params.ACTION}

========================================
"""
        }

        always {
            echo "Pipeline execution completed."
        }
    }
}
