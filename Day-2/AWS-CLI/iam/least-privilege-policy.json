{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeOwnTags",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PublishBenchmarkMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "PIP/EC2Benchmark"
        }
      }
    }
  ]
}
